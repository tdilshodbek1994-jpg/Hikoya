# ---------------------------------------------------------------------------
# HIKOYA PRO configuration. Copy to deploy/.env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# Database (docker compose creates it)
POSTGRES_USER=hikoya
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=hikoya

# Public URLs
DOMAIN=hikoya.example.uz
WEB_PORT=8080
HIKOYA_ENV=production
HIKOYA_PUBLIC_BASE_URL=https://hikoya.example.uz
HIKOYA_WEBAPP_URL=https://hikoya.example.uz
HIKOYA_CORS_ORIGINS=["https://hikoya.example.uz"]

# Telegram (from @BotFather). Keep the token secret.
HIKOYA_BOT_TOKEN=
HIKOYA_BOT_USERNAME=your_bot_username
HIKOYA_MINIAPP_SHORT_NAME=app
# Random string; Telegram sends it back in X-Telegram-Bot-Api-Secret-Token
HIKOYA_WEBHOOK_SECRET=
HIKOYA_TELEGRAM_ENABLED=true

# Owner(s): Telegram numeric IDs (not usernames). JSON list.
HIKOYA_OWNER_TELEGRAM_IDS=[123456789]
# Test accounts excluded from TOP/statistics
HIKOYA_TEST_TELEGRAM_IDS=[]

# Security
# Random 32+ chars, used to sign 60-second private file links
HIKOYA_SIGNING_KEY=
HIKOYA_INIT_DATA_MAX_AGE_SECONDS=300
HIKOYA_SESSION_TTL_HOURS=72
HIKOYA_DEV_AUTH_ENABLED=false

# Payments: keep false until the owner has set real prices (/price in the bot)
HIKOYA_BILLING_ENABLED=false

# Storage: local (docker volume) or s3 (S3/MinIO/R2)
HIKOYA_STORAGE_BACKEND=local
HIKOYA_S3_ENDPOINT_URL=
HIKOYA_S3_BUCKET_PRIVATE=
HIKOYA_S3_BUCKET_PUBLIC=
HIKOYA_S3_ACCESS_KEY=
HIKOYA_S3_SECRET_KEY=
HIKOYA_S3_PUBLIC_BASE_URL=
HIKOYA_SIGNED_URL_TTL_SECONDS=60

# Storis durations allowed (24 always). Example to enable 48/72: [24,48,72]
HIKOYA_STORY_ALLOWED_HOURS=[24]

HIKOYA_TIMEZONE=Asia/Tashkent

# Optional: proxy for Telegram Bot API if api.telegram.org is blocked from the server
# HIKOYA_TELEGRAM_PROXY=
# If api.telegram.org is blocked from the server (check: make bot-check), use a relay instead of a proxy:
# deploy/telegram-relay/worker.js on Cloudflare Workers → https://<name>.<account>.workers.dev
HIKOYA_TELEGRAM_API_BASE=https://api.telegram.org
# true when the host's IPv6 route to Telegram is broken but IPv4 works
HIKOYA_TELEGRAM_FORCE_IPV4=falsesocks5://user:pass@host:1080
HIKOYA_TELEGRAM_PROXY=

# --- Stage C options ---------------------------------------------------------
# WAL archive switch interval in seconds (RPO). Base backups: deploy/basebackup.sh (cron).
WAL_ARCHIVE_TIMEOUT=300
# Antivirus: start with --profile antivirus and set HIKOYA_CLAMAV_HOST=clamav
HIKOYA_CLAMAV_HOST=
HIKOYA_CLAMAV_REQUIRED=false
# AI helper (optional). Empty provider = disabled. Key only in this file, never in chat or git.
HIKOYA_AI_PROVIDER=
HIKOYA_AI_API_KEY=
HIKOYA_AI_MODEL=claude-opus-5-5
HIKOYA_AI_DAILY_LIMIT_PER_USER=20
# Invite a friend: inviter gets N Premium days after the friend's first real read (0 = off)
HIKOYA_REFERRAL_BONUS_DAYS=3
HIKOYA_REFERRAL_MAX_REWARDS_PER_MONTH=10
# Author royalties (share of single-work sales, %). 0 = disabled.
HIKOYA_ROYALTY_SHARE_PERCENT=0
HIKOYA_ROYALTY_HOLD_DAYS=21
