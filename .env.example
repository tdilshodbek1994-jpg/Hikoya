# DTM botingiz tokeni (BotFather'dan). Mini App so'rovlarini tekshirish uchun.
BOT_TOKEN=

# Claude API kaliti (AI suhbatdosh): https://console.anthropic.com
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5   # standart: eng tez
# CLAUDE_EFFORT=low

# OpenAI kaliti: ovozni matnga aylantirish va AI ovozi uchun
OPENAI_API_KEY=
# STT_MODEL=gpt-4o-transcribe
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=coral

# Gemini kaliti (ixtiyoriy): o'zbekcha gaplarni tabiiyroq ovozda aytish uchun
# https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=  (bo'sh qolsa avtomatik tanlanadi)
# GEMINI_LIVE_VOICE=Kore
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_VOICE=Kore
# LIVE=1   # 📞 jonli qo'ng'iroq (Gemini Live) — standart: o'chiq

# Microsoft Azure Speech: o'zbekcha ovoz (Gemini'dan oldin ishlatiladi)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_VOICE=uz-UZ-MadinaNeural   # erkak ovozi: uz-UZ-SardorNeural

# Natija ulashilganda qo'shiladigan havola (masalan https://t.me/Uzdtm_bot)
SHARE_URL=

# Statistika sahifasi kaliti: /admin.html?key=...
ADMIN_KEY=

PORT=3000
SESSION_MINUTES=10
# Bir foydalanuvchi uchun kunlik darslar soni
DAILY_SESSIONS=0

# Telegram'siz oddiy brauzerda sinash uchun 1 qiling (serverda 0 bo'lsin!)
ALLOW_DEV=0
